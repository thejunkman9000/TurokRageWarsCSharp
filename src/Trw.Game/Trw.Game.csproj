<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Trw.Platform\Trw.Platform.csproj" />
    <ProjectReference Include="..\Trw.Structs\Trw.Structs.csproj" />
    <!-- typed struct views live in their own assembly (Trw.Structs) -->
    <Compile Remove="Generated\Structs\**" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
    <MonoGameContentReference Include="Content\Content.mgcb" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- the generated code is a faithful translation: unreachable code, unused locals and unused labels are expected -->
    <NoWarn>$(NoWarn);CS0162;CS0164;CS0168;CS0219;CS0169;CS0649;CS8981;CS8669</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <MonoGamePlatform>DesktopGL</MonoGamePlatform>
  </PropertyGroup>

  <!-- Online play (docs/NETPLAY.md): accounts and lobbies through the jsNetwork master (D:\Projects\jsLibs, a sibling checkout; override with
       the JsLibsDir property overrides the path). Without it the game still builds: netplay then works only with direct connections (net-direct / net-listen switches). -->
  <PropertyGroup>
    <JsLibsDir Condition="'$(JsLibsDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\jsLibs\</JsLibsDir>
    <DefineConstants Condition="Exists('$(JsLibsDir)jsNetwork.Client\jsNetwork.Client.csproj')">$(DefineConstants);TRW_JSNETWORK</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(JsLibsDir)jsNetwork.Client\jsNetwork.Client.csproj')">
    <ProjectReference Include="$(JsLibsDir)jsNetwork.Client\jsNetwork.Client.csproj" />
  </ItemGroup>

</Project>


