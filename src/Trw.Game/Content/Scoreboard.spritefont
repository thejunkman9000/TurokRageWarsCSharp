<?xml version="1.0" encoding="utf-8"?>
<!-- Font of the port-drawn scoreboard overlay (Window/Scoreboard.cs): the game's own font. Drawn scaled with the window; ASCII only (player names are ASCII in the game). -->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Fonts/Peaceful Wars.ttf</FontName>
    <Size>28</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <DefaultCharacter>?</DefaultCharacter>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
